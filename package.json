{
  "name": "@scalebrowser/sdk",
  "version": "1.1.0",
  "description": "Official Node/TypeScript SDK for the Scalebrowser daemon: typed REST client plus a direct-CDP driver plane (nodriver-style, not Playwright).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://scalebrowser.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackdiamond-labs/scalebrowser-node.git"
  },
  "bugs": {
    "email": "support@scalebrowser.net"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "lint": "eslint src test examples",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "scalebrowser",
    "ai-agents",
    "agent-browser",
    "browser",
    "cdp",
    "chrome-devtools-protocol",
    "mcp",
    "browser-automation",
    "sdk"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
